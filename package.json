{
  "name": "@test-heal/mcp-server",
  "version": "0.3.3",
  "description": "MCP server that gives AI coding agents a disciplined, zero-cost protocol for diagnosing and fixing failing tests. Uses the host agent's own model.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "test-heal": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node bin/run.js",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build || true",
    "smoke": "tsx scripts/smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "coding-agents",
    "test-fix",
    "claude-code",
    "cursor",
    "debugging",
    "root-cause",
    "zero-cost"
  ],
  "author": "TestHeal Contributors",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webscout9-png/test-heal.git"
  },
  "homepage": "https://github.com/webscout9-png/test-heal#readme",
  "bugs": {
    "url": "https://github.com/webscout9-png/test-heal/issues"
  }
}
